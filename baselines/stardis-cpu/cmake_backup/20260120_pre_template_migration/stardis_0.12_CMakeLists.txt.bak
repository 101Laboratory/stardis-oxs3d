message(STATUS "  - star-enclosures-3d: ${SENC3D_ROOT}")
message(STATUS "  - star-sp: ${SSP_ROOT}")
if(SG3D_AVAILABLE)
    message(STATUS "  - sg3d: ${SG3D_ROOT}")
else()
    message(STATUS "  - sg3d: NOT FOUND (optional)")
endif()
if(SSTL_AVAILABLE)
