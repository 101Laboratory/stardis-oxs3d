@article{wuRealtimeMidwavelengthInfrared2015,
  title = {Real-Time Mid-Wavelength Infrared Scene Rendering with a Feasible {{BRDF}} Model},
  author = {Wu, Xin and Zhang, Jianqi and Chen, Yang and Huang, Xi},
  year = 2015,
  month = jan,
  journal = {Infrared Physics and Technology},
  volume = {68},
  pages = {124--133},
  issn = {1350-4495},
  doi = {10.1016/j.infrared.2014.11.011},
  urldate = {2025-05-21},
  abstract = {Practically modeling and rendering the surface-leaving radiance of large-scale scenes in mid-wavelength infrared (MWIR) is an important feature of Battlefield Environment Simulation (BES). Since radiation transfer in realistic scenes is complex, it is difficult to develop real-time simulations directly from first principle. Nevertheless, it is crucial to minimize distortions in the rendering of virtual scenes. This paper proposes a feasible bidirectional reflectance distribution function (BRDF) model to deal with a large-scale scene in the MWIR band. Our BRDF model is spectrally dependent and evolved from previous BRDFs, and meets both Helmholtz reciprocity and energy conservation. We employ our BRDF model to calculate the direct solar and sky contributions. Both of them are added to the surface thermal emission in order to give the surface-leaving radiance. Atmospheric path radiance and transmission are pre-calculated to speed up the programming for rendering large scale scenes. Quantitative and qualitative comparisons with MWIR field data are made to assess the render results of our proposed method.},
  langid = {english},
  keywords = {BRDF,Infrared simulation,Large scale scene,Real time rendering},
  annotation = {TLDR: This paper proposes a feasible bidirectional reflectance distribution function (BRDF) model to deal with a large-scale scene in the MWIR band, which is spectrally dependent and evolved from previous BRDFs, and meets both Helmholtz reciprocity and energy conservation.},
  file = {C\:\\Users\\EricPu\\Zotero\\storage\\KK8DGK4M\\Wu 等 - 2015 - Real-time mid-wavelength infrared scene rendering with a feasible BRDF model.pdf;C\:\\Users\\EricPu\\Zotero\\storage\\BVQCFID7\\S1350449514002631.html;C\:\\Users\\EricPu\\Zotero\\storage\\TB9ZVTWC\\S1350449514002631.html}
}

@phdthesis{XuFeiFanJiYuOptiXBingXingGuangXianZhuiZongJiSuanDeHongWaiChengXiangFangZhenRuanJianYanZhi2022,
  type = {{硕士学位论文}},
  title = {{基于OptiX并行光线追踪计算的红外成像仿真软件研制}},
  author = {徐非凡},
  year = 2022,
  address = {哈尔滨},
  abstract = {红外成像是航天及国防领域中的重要探测手段之一,而红外热像仪的研发需要大量费时费力的外场试验,因此红外成像仿真框架具有重要意义。目前许多成熟的红外成像仿真软件均为国外团队研发,国内对通用的红外成像仿真系统的研究较少,且由于计算时间的限制,以往的研究通常使用光栅化方法,成像结果的真实感较差。光线追踪方法能够获得更准确、真实感更高的成像结果,但需要大量的计算时间,而随着并行计算的兴起,在GPU上使用光线追踪方法进行计算能够节省大量的时间成本。本文通过OptiX光线追踪引擎进行了并行计算的红外成像仿真软件的开发,并使用自编软件对不同的场景进行了仿真计算。本文基于光线追踪方法建立了红外辐射传输计算理论。在自发辐射的计算中,本文根据等效粗糙度理论,使用对Fresnel方程的Schlick近似描述表面发射率的方向性。在反射辐射的计算中,使用了蒙特卡洛积分方法实现对半球空间的积分,并引入了流式重采样重要性采样(Streaming RIS)算法来加快计算的收敛速度。详细介绍了大气效应、太阳、天空及地表辐射对红外辐射传输的影响,并给出了红外成像仿真的整体链路图。根据成像仿真软件的整体框架图,本文使用C++和CUDA语言进行开发。实现了基于BVH加速结构的场景管理。引入了基于微表面模型的Cook-Torrance BRDF模型以及为飞行器红外信号预测而提出的Sandford-Robertson BRDF模型来描述表面的方向反射特性。使用ECOSTRESS光谱库以及MODTRAN软件的计算结果建立了软件的材料光谱发射率、大气效应及环境辐射数据库。实现了辐亮度计算结果的灰度图像映射以及伪彩色图像映射,并引入了循环降噪自动编码器对计算结果进行降噪处理。对不同场景在中红外波段以及远红外波段进行了仿真计算,结果表明,本文的仿真软件能够快速生成准确仿真图像,从伪彩色图中能够清晰的看出场景辐亮度的分布。分析了不同大气条件及环境辐射对成像仿真结果的影响,结果表明,太阳辐射对中红外波段成像结果的影响较大而对远红外波段成像结果的影响较小,其他因素对两个波段的影响相似。分析了软件计算效率以及降噪效果,结果表明光线追踪计算占据了软件的大���分计算时间,循环降噪自动编码器能够在减少成像结果噪点的同时提高图像的质量。},
  langid = {chinese},
  school = {哈尔滨工业大学},
  keywords = {,BRDF,GPU},
  file = {C:\Users\EricPu\Zotero\storage\RXQ8T27R\徐非凡 - 2022 - 基于OptiX并行光线追踪计算的红外成像仿真软件研制.pdf}
}

@phdthesis{XuZhenDaoTanKeMuBiaoYuFuZaDiMianBeiJingOuHeReHongWaiTeZhengYanJiu2023,
  type = {{博士学位论文}},
  title = {{坦克目标与复杂地面背景耦合热红外特征研究}},
  author = {{徐振道}},
  year = 2023,
  address = {南京},
  abstract = {在日益复杂和科技水平愈发增强的现代战场环境中,红外精确制导武器的研发愈加受到重视。在各种新型红外制导武器的设计、研制过程中,需要获取坦克目标在不同时间、不同工作状态、不同地面背景中的热红外特征数据,以实现真假目标的识别、追踪和精确打击。在实际战场环境中,坦克目标总是处于一定的背景中,且坦克目标的热红外特征会与背景发生耦合,使得目标或背景呈现出与单独研究时不同的热红外特征,影响坦克目标的探测概率。因此,对不同工作状态(冷静态、热静态及热动态)的坦克目标与复杂地面背景之间的热红外耦合现象进行深入的研究,形成耦合红外辐射特征数据库,进而实现坦克与地面背景耦合红外场景的生成,对于红外导引头的研发和坦克的隐身设计具有重要意义。本文首先研究了复杂地面背景的热红外特征,在此基础上建立了静态坦克目标(冷静态、热静态)与地面背景的耦合热红外特征模型,对不同时刻的静态坦克与典型地面背景的耦合热红外特征进行了对比分析。然后针对动态坦克行驶时与地面耦合引起的痕迹和扬尘现象进行了深入的研究,分别分析了痕迹对地面背景红外特征的影响和扬尘对坦克尾气红外特征的影响。最终通过开发红外场景仿真平台实现了坦克目标与地面背景耦合红外场景的生成。具体内容主要包括以下几个方面: 1.战场环境中复杂地面背景热红外特征研究 首先通过建立地面背景的一维温度场和红外特征计算模型,研究了不同地表材质平均温度和红外特征变化规律。进而利用神经网络方法对可见光影像进行材质分割,结合材质的热红外特征模型,得到了场景地表的平均温度和红外图像。然后针对平均热红外图像中缺乏真实感的问题,对于水平地表和起伏地表,分别给出了增强地表温度真实感的计算模型。对于水平地表,利用可见光图像中包含的太阳辐射信息,结合材质温度对太阳直射比例和短波吸收率的灵敏度分析,建立了温度特征细节调制模型。对于起伏地表,基于地表数字高程模型(DEM,Digital Elevation Model),考虑单元表面法向与太阳直射方向夹角的不同、各单元表面间的相互遮挡,建立了三维地面背景的温度场计算模型。最终获得了更真实的地表温度场和红外特征分布。 2.静态坦克目标与复杂地面背景耦合热红外特征研究 通过分析静态坦克目标与不同地面背景的热相互作用过程,在地面背景热红外特征研究的基础上,建立了描述坦克目标与地面背景间能量传递的静态耦合热红外特征模型,讨论了晴朗天气条件下不同时刻静态坦克目标与3种典型地面背景(水泥、裸土...},
  langid = {chinese},
  school = {南京理工大学},
  annotation = {CNKICite: 1},
