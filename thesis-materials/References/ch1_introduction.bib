@article{huangGPUbasedHighprecisionRealtime2014,
  title = {{{GPU-based}} High-Precision Real-Time Radiometric Rendering for {{IR}} Scene Generation},
  author = {Huang, Xi},
  year = 2014,
  month = jul,
  journal = {Infrared Physics and Technology},
  volume = {65},
  pages = {134--143},
  publisher = {Pergamon},
  issn = {1350-4495},
  doi = {10.1016/j.infrared.2014.04.007},
  urldate = {2025-05-11},
  abstract = {Aiming at the problem that traditional infrared scene real-time radiometric rendering method  leads to greater calculation error for securing real-time purpose, this article studies the IR  rendering comprehensive optimization method, which secures real-time performance as well as  calculation accuracy. Firstly, based on the effective average value principle, the spectrum coupling  thermal emission and reflected radiations in the spectral radiometric equation are decomposed into  physical quantities, and the spectral radiometric equation is improved to become a simpler  calculation between "primer" radiance terms and effective average factors. Secondly, the  parameter processing method is proposed to cope with the situation when index parameters of  effective average factors exceed the maximum dimensionalities of graphics processing unit (GPU)  look-up-table (LUT); and pre-calculation method is applied to promote the real-time evaluation  efficiency of the physical quantities in the radiometric equation. Finally, concurrent computation  of radiometric equation is achieved with GPU IR scene generation software and the precise and  real-time rendering of three-dimensional IR scene is realized.},
  langid = {english},
  annotation = {TLDR: The IR rendering comprehensive optimization method secures real-time performance as well as calculation accuracy, and concurrent computation of radiometric equation is achieved with GPU IR scene generation software and the precise and real- time rendering of three-dimensional IR scene is realized.\\
abstractTranslation: 红外场景实时仿真广泛应用于战场环境仿真、数字/HWIL仿真测试、飞行训练以及热红外遥感建模[1-3]等军事和民用领域。在实时红外场景生成过程中，目标、背景和大气辐射相互作用下带内辐射的准确、高速计算，以及大气对目标辐射衰减和对比度变化的影响的准确体现，在很大程度上决定了模拟图像的真实感和实时性。然而，精确的三维场景红外渲染通常非常耗时。原因是多方面的。首先，高精度辐射方程包括大量的光谱计算，以表示源、反射面和大气之间的光谱耦合。其次，每个像素通常对应于通过大气的不同视线，这意味着每个像素根据辐射方程进行独立计算。在实时红外图像的生成中，单位时间内辐射方程的总计算量与模拟帧与像素数量的乘积成正比，是一个巨大的量。此外，在每个像素的辐射渲染中，由于视线的不同，大气透过率和路径辐射度等物理量是动态确定的，并且使用MODTRAN软件计算这些物理量也很耗时。针对以上在3D场景红外绘制中耗时的因素，研究人员提出了相关的实时优化方法。首先，对于辐射方程中的频谱形式耗时问题，Williams等人[4]、He等人[5]、Wu等人[6]、Jiang等人[7]采用透射平均值近似来简化频谱方程。平均值近似的核心思想是用带平均衰减近似代替精确频谱方程中辐射分量的频谱衰减积分计算，显著减少了计算量，因此被VIRSuite[8]、Vega/Vega Prime[9]、JRM[10]、SE Workbench IR[11,12]等大多数实时红外场景模拟软件采用。其次，针对实时计算量巨大的问题，基于仿真图像中不同像素的辐射渲染是离散的，因此可以并发进行的特点，研究人员采用了基于GPU的并行计算方法[2,4-8,10-12]或基于多核CPU的并行计算方法[13]来提高实时性能，并实现了有效的帧速率加速。由于GPU在三维图形数据的并行处理方面比CPU具有更高的效率，基于GPU的辐射绘制方法受到了研究人员的广泛关注。此外，对于直接计算辐射方程物理量所需的时间，研究人员通常采用物理量查表法进行优化，即根据已知的气象条件和观测几何变化范围，利用Modtran软件预先计算辐射衰减方程中的大气平均透射率、大气路径辐射度等物理参数，并保存为LUT。在实时绘制阶段，通过在LUT中进行实时查找，并根据精确的视线几何参数进行插值，实现了平均透射率等参数的实时采集。与辐射方程的并行计算一样，LUT的实时插值可以分别在GPU或CPU中进行。因此，辐射物理量查找表方法进一步分为基于GPU的物理量查找表格方法[4-12]和基于CPU的物理量查询表格方法[4,13]。与基于CPU的物理量LUT方法相比，基于GPU的物理量LUT方法通常具有更高的并行计算效率，但在数据大小和数据维数方面受到了较大的限制。例如，根据GPU对输入数据的限制（格式为纹理），GPU LUT方法仅支持三个最大维度。通过在实时辐射计算中定义气象条件、波段范围等参数保持不变，从而保证方程中的物理量依赖于三个指数参数中的最大值进行实时插值。由上述GPU LUT方法生成的GPU纹理不超过3的维数。最后，将这三种实时优化方法综合应用于实时过程中，可以有效地实现目标、背景和大气相互作用下的辐射计算，从而满足红外场景仿真应用对实时性能日益苛刻的要求。例如，在HWIL模拟中，可以生成帧频为100\textasciitilde 400Hz的模拟图像[2,13]。经进一步分析，以上实时优化方法都是基于大气平均透过率进行辐射计算的。根据参考文献[9]和本文的相关误差计算，简化大气平均透过率可能会导致不同程度的计算误差。在一定条件下，黑体或灰体辐射衰减误差为15\%以上，反射太阳辐射衰减误差超过-40\%，选择性辐射体状羽流甚至具有远大于100\%的辐射衰减误差。实时辐射渲染方法在准确性方面的不足，降低了计算结果的可信度和模拟试验的可靠性；同时也制约了红外场景实时仿真技术在多光谱成像系统开发与测试、高真实感红外建模等研究人员越来越关注的领域中的进一步深入应用。因此，如何在提高计算精度的同时满足辐射渲染的实时性能是一个重要而富有挑战性的课题。Cathala等人[14]采用了一种基于图像的渲染方法，该方法使用精确的光谱算法来预计算一组羽流辐射和衰减纹理。但由于辐射和透射重建算法的局限性，很难将衰减校正方法从简单的轴对称羽流扩展到具有复杂三维几何轮廓的目标和地形。Lepage等人[15]使用宽带版本的相关-k理论，将宽带上的全积分减少为宽带ck空间中几个ck系数上的总和。该方法在正确再现飞机和耀斑特征的光谱特性的同时，显著提高了辐射方程计算效率，但在计算大气透射率和辐射度等物理量时，与MODTRAN结果相比，仍然存在约5\%的误差。为了实现精确、实时的红外绘制，本文首先利用有效平均原理对复杂的光谱辐射方程进行了变换，建立了一个既能保持光谱耦合精度又能简化光谱积分的修正辐射方程，保证了各种辐射器（特别是选择性辐射器）总辐射的精度；然后，针对有效平均因子的实时指标参数个数超过GPU LUT的最大维数的问题，研究了多指标参数LUT预计算方法，并形成了相应的GPU纹理；最后，完成了基于GPU平台的三维场景红外实时渲染，生成高帧频、高精度的图像。本文的结构如下：第二节对热辐射、反射辐射等光谱耦合辐射分量进行物理量分解，将辐射方程修改为``引物''辐射项和有效平均因子的基本算术运算。第3节介绍如何将有效平均因子参数化以在LUT中预计算并存储���GPU纹理中。第四节利用GPU红外场景生成软件完成了辐射方程的精确快速计算。},
  file = {C\:\\Users\\EricPu\\Zotero\\storage\\WVGY72MG\\2014 - GPU-based high-precision real-time radiometric rendering for IR scene generation.pdf;C\:\\Users\\EricPu\\Zotero\\storage\\MD9Z2QYB\\S1350449514000711.html}
}

@phdthesis{HuangXiGaoZhenShiGanHongWaiChangJingShiShiFangZhenJiShuYanJiu2014,
  type = {{博士学位论文}},
  title = {{高真实感红外场景实时仿真技术研究}},
  author = {黄曦},
  year = 2014,
  address = {西安},
  abstract = {红外场景实时仿真技术通过生成目标、背景的红外特性并模拟红外成像系统的实际工作方式,具有可靠、无破坏性、可多次重复、不受气象条件和场景空域限制、控制灵活等特点,能够降低研发风险、缩短研制周期、节约研究与试验经费,具有重要的军用和民用应用价值。而随着个人计算机与图形处理单元相结合的仿真硬件在运算性能上的飞速进步,进行更真实、复杂的物理现象与过程实时模拟成为可能,使得基于GPU构建红外场景实时仿真软件,并提高软件各子模块的拟真度越来越为研究者所重视。本文以建设系统化、基于物理的、高真实感、实时红外场景仿真软件为目标,对通用仿真框架设计、红外纹理生成、辐射特征渲染与大气传输效应仿真等关键问题进行了研究,开展的具体工作如下:第一部分研究基于GPU的红外场景实时仿真框架设计。分析了红外场景仿真的相似理论与复合系统的全链路关系,剖析了国外典型红外场景仿真软件的框架特点、模块组成与图像生成流程,总结出红外场景实时仿真框架应遵循的模块化、层次化、系统化及实时优化等设计准则。依据设计准则,完成了红外场景实时仿真框架与子模块设计,模块具备低耦合与高内聚特点,易于扩充与修改;工作层次分解为``数据管理-建模与设计-图像生成''三层结构,层中数据接口稳定,层间交流清晰、方便;模拟成像链路,实现了``目标-背景-大气-成像系统''的复合系统设计;对仿真模块基于物理建模,保障计算结果物理可信;在高级渲染引擎基础上构建基于GPU的三维红外渲染引擎,提高了稳定性,降低了开发难度。通过构建红外导引头半实物仿真试验系统验证了仿真框架的可用性。第二部分研究高真实感红外纹理生成方法。依据红外辐射计算理论设计了红外场景GPU实时仿真框架所用的红外物理纹理格式。分析了实测法与数字仿真方法生成目标红外纹理的优缺点互补性,提出了将测量图像与数学反演模型结合来生成准确、自然、细节丰富的目标表面温度场分布,再结合三维渲染技术实现灵活的目标红外图像仿真,得到了一种基于实测反演方法的目标红外纹理生成方法。分析了由于实测法红外数据获取困难、成本高,而人工设计法生成的大规模地物红外纹理边界生硬、细节重复等问题,采用可见光遥感图像分割获取了准确、自然的地物材质区域分布,然后分别从材质的可见光光学属性变化、地物海拔变化、相邻区域热传递等方面对温度分布细节进行了基于物理模型的调制,得到了一种基于可见光遥感图像生成大规模地物红外纹理的改进方法,应用于三维地表仿真,生成的红外图像真实感强,实...},
  langid = {chinese},
  school = {西安电子科技大学},
  keywords = {,GPU},
  annotation = {CNKICite: 69},
  file = {C:\Users\EricPu\Zotero\storage\68JDLG3H\黄曦 - 2014 - 高真实感红外场景实时仿真技术研究.pdf}
}

