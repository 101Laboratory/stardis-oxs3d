@phdthesis{LiuHanJiYuTuXiangFengGeQianYiDeHongWaiShiJingFangZhenJiShuYanJiu2024,
  type = {{硕士学位论文}},
  title = {{基于图像风格迁移的红外视景仿真技术研究}},
  author = {刘晗},
  year = 2024,
  address = {武汉},
  abstract = {目前,红外视景仿真技术的需求正大扩大,其主要的研究方向受许多因素影响,特殊场景下的红外图像不便获取,实际应用受限。以红外视景仿真技术中的可见光-红外纹理生成技术为需求牵引,本文结合人工智能领域中图像风格迁移算法在纹理生成方面的优势,开展基于图像风格迁移的神经网络算法在红外视景仿真技术中的应用基础研究,可以仿真特定条件下的红外图像,使得在特殊条件下不便获取红外图像的问题得到了解决,为红外视景仿真技术的研究发展提供了便利。为了揭示图像迁移网络对红外纹理生成的影响,本文对比优化了基于图像迭代和基于模型迭代两种图像风格迁移方法去实现红外视景仿真技术中红外纹理的生成,为红外视景仿真技术提供基础技术支撑。研究的主要内容与结论如下: (1)将图像风格迁移算法引入到红外视景仿真技术中,分别使用基于图像迭代和基于模型迭代的方法去构建红外风格模型。并将各个红外模型仿真生成的效果图与传感器获取的红外图像进行对比评估,评估所用的图像指标有直方图、结构相似性(SSIM)、峰值信噪比(PSNR)。实验结果表明,两种模型都能实现指定场景下的红外仿真,验证了模型的有效性。且在相同仿真条件下,黑白红外图像的红外仿真效果更佳。 (2)深入研究图像风格迁移算法的作用和红外图像的纹理特点,根据仿真效果对图像迭代方法和模型迭代方法进行优化改进,将优化算法与其他图像生成模型进行红外仿真效果的对比,并通过图像评价指标加以验证。实验结果表明,在小数据量的训练条件下,优化后的模型能达到更好的红外仿真结果,验证了优化模型的有效性。对于数据、计算资源充足的场景,基于模型迭代的方法比基于图像迭代的方法更适合红外纹理的生成。},
  langid = {chinese},
  school = {湖北大学},
  file = {C:\Users\EricPu\Zotero\storage\86SHVW4X\刘晗 - 2024 - 基于图像风格迁移的红外视景仿真技术研究.pdf}
}

@article{WangJunDiHaiMianHongWaiChangJingShengChengJiShuYanJiu2020,
