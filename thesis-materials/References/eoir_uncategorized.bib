}

@article{YuHuiJuanDiMianMuBiaoHongWaiChengXiangFangZhenXiTongDeSheJiYuShiXian2013,
  title = {{地面目标红外成像仿真系统的设计与实现}},
  author = {{余慧娟} and {黎兰} and {刘相新} and {韦学中}},
  year = 2013,
