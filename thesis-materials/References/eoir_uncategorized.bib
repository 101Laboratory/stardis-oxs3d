@phdthesis{DuHuiRanQiFuDiBiaoJiDiMianChangJingHongWaiTeXingFangZhenRuanJianYanZhi2022,
  type = {{硕士学位论文}},
  title = {{起伏地表及地面场景红外特性仿真软件研制}},
  author = {{杜慧冉}},
  year = 2022,
  address = {哈尔滨},
  doi = {10.27061/d.cnki.ghgdu.2022.002835},
  abstract = {红外成像技术在夜间或者恶劣环境中具有观测、识别的优势,拓宽了人类的视觉范围,更有利于人们对信息进行获取,使其在军事、工业、建筑等领域的应用逐渐广泛,吸引越来越多的研究人员对目标及背景的红外仿真特性进行研究。红外成像仿真主要指根据预先设定的几何模型、天气情况、材质物性等生成相应目标的红外成像。目前国内外的研究人员对此已经具备了较成熟的理论,但国内缺少对目标及背景红外仿真的国产化软件。本文完成了对地表及目标红外特性仿真软件的研制,软件可以实现在天气状况不断变化、地表起伏变化、地表区域材质不相同的情况下对地表红外辐射特性的求解,对国产化红外仿真软件的研制具有重要意义。对地表表面与环境之间的热量交换进行分析,考虑不同时刻天气状况及太阳高度角的变化,将太阳辐射、大气辐射及与环境之间的潜热交换、对流交换、向地表以下的传热考虑在内,从而计算出一天内地表温度值变化。利用开发的程序计算出的结果与文献中实际测量的温度场进行对比验证,验证了程序结果的正确性。依据地表背景的数字高程模型,对起伏地表表面进行几何建模。在建立了几何模型的基础上,考虑起伏地表各面元之间的遮挡关系,对各面元接收到的太阳辐射值进行修正。根据地表不同的区域材料不同的情况,本文利用卫星拍摄的地表图的颜色来识别地表各部分区域材料的方法,实现区域材料与物性之间较准确的匹配,对地表表面温度场及红外辐射进行计算。对海面及桥梁进行红外模拟仿真。海水具有较强的动态随机性,海面振幅的高度随着风速变化而不断变化,故将海面模型的建立转化为对海面高度的重新建立。在海面几何模型基础上,根据海水物性特点计算温度场及红外辐射特性。海水具有较大的比热容,一天内海水温度变化不大。海面区域范围较广,随海水起伏温度变化不大。将桥梁几何模型进行简化,根据桥梁各部分的材料不同进行模型颜色的划分,便于赋值相应物性参数,对桥梁温度场及红外特性进行模拟。��外辐射值越大,给人感官上越亮。模拟结果表明桥梁桥面亮度较大,而桥墩及护栏亮度较小。即桥面红外辐射值较大,桥墩及护栏较小。桥梁与水面构成的场景结合,对场景进行红外模拟仿真。},
  collaborator = {{赵军明}},
  langid = {chinese},
  school = {哈尔滨工业大学},
  annotation = {CNKICite: 1},
  file = {C:\Users\EricPu\Zotero\storage\8WQPLMXX\杜慧冉 - 2022 - 起伏地表及地面场景红外特性仿真软件研制.pdf}
}

@article{HanYuGeZiRanDiBiaoHongWaiTuXiangDeMoNi2000,
  title = {{自然地表红外图像的模拟}},
  author = {{韩玉阁} and {宣益民}},
  year = 2000,
  journal = {红外与激光工程},
  number = {2},
  pages = {57--59, 64},
  issn = {1007-2276},
  urldate = {2025-05-11},
  abstract = {自然界的地表是非常复杂的 ,影响其温度分布和红外辐射特性的因素很多 ,如地表的起伏、土壤类型、植被类型、土壤湿度和气象条件等。要精确计算自然地表的温度和红外辐射特性 ,生成红外图像 ,必须建立考虑各种影响因素的三维传热传质模型。这种方法要花费大量的计算时间 ,是不实用的。文中利用一维模型的计算结果并结合随机模拟方法 ,针对具体自然地表 (不同植被、裸露地表等 )的实际红外辐射强度的相关长度、均方根误差以及相邻像素点的空间距离 ,模拟生成了自然地表的红外图像。探测器的视场和视角对观察到的图像影响是很大的 ,对同一地面区域 ,使用不同视场的探测器观察 ,得到的图像不同 ,即使使用同一探测器 ,如果用不同的视角观察同一区域 ,得到的图像也是不同的。因此文中根据不同的红外探测器视场以及同一探测器的不同的视角 ,将该图像转换成了红外探测器视场内的图像 ,分析了对应不同视场和视角的自然地表红外图像的特征。},
  langid = {chinese},
  annotation = {download: 402\\
album: 信息科技\\
CLC: TN219\\
dbcode: CJFQ\\
dbname: CJFD2000\\
filename: HWYJ200002013},
  file = {C:\Users\EricPu\Zotero\storage\6M2J7CXK\韩玉阁和宣益民 - 2000 - 自然地表红外图像的模拟.pdf}
}

