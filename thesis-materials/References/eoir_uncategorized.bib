@phdthesis{YiTengYiJiYuShiCeHongWaiTuXiangDeDuoCaiZhiMuBiaoWenDuChangFanYan2023,
  type = {{硕士学位论文}},
  title = {{基于实测红外图像的多材质目标温度场反演}},
  author = {{弋腾翼}},
  year = 2023,
  address = {西安},
  doi = {10.27389/d.cnki.gxadu.2023.001898},
  urldate = {2025-05-11},
  abstract = {红外成像仿真技术具有灵活性强、研发周期短、试验成本低等特点,被广泛应用于红外成像系统的设计与评估、红外成像制导算法的开发与测试等领域。相较于实测红外图像,仿真图像存在真实感较低、纹理边界生硬等缺点。基于实测红外图像反演目标表面真实温度场分布,将真实温度分布数据应用于红外成像仿真中的方法可以有效提高仿真图像真实感。本文依据红外成像物理过程,以建立更加完备、精细的针对多材质目标的温度反演链路模型为目标,对红外辐射大气传输机理、红外成像系统效应、红外目标材质分割、方向发射率校正等温度反演过程所涉及到的一系列关键问题展开研究。首先,分析红外成像过程中的影响因素,建立红外辐射大气传输效应模型及成像系统效应模型。通过研究大气对红外辐射的吸收、散射作用,得到辐射衰减的主要原因及计算方法;基于散射相函数,实现大气散射能量空间分布的定量计算;建立基于折射率结构常数的大气湍流效应参数化模型,定量分析大气湍流所导致的红外图像模糊现象。针对成像系统各模块对红外辐射强度及空间分布的影响,分别建立成像系统信号传递特性模型与空间传递特性模型,实现成像系统效应的定量表征。其次,从红外图像出发,基于红外成像逆过程,建立完整的目标本征辐射反演链路。通过盲元检测与补偿、非均匀性校正等算法,消除成像系统噪声的影响;以试验的方式,分析非制冷型红外成像系统响应漂移规律,为成像系统信号传递特性反演提供参考;基于调制传递函数理论,复原因成像系统空间传递效应与大气湍流效应所导致的红外图像退化;补偿大气衰减、去除大气路径辐射,得到��标零视距处本征辐射场分布。之后,基于本征辐射场数据,反演多材质目标表面温度场。引入可见光图像,解决红外目标材质分割的难题。通过异源图像配准,生成与红外图像空间对齐的可见光图像,分割可见光图像,获取红外目标材质分布。针对材质发射率随辐射方向变化所引起的温度反演误差,基于屏幕空间法线渲染技术,逐像素计算目标表面辐射方向,设置方向发射率,进而基于普朗克公式,计算目标表面温度。最后,介绍多材质目标温度反演算法总体框架,并针对实测红外图像进行温度反演试验,结果表明,本文反演算法具有较高精度,能够为红外成像仿真提供精确的温度场分布数据。},
  collaborator = {{黄曦} and {陈遵田}},
  langid = {chinese},
  school = {西安电子科技大学},
  annotation = {major: 工程硕士（专业学位）\\
download: 106\\
album: 信息科技\\
CLC: TP391.41;TN219\\
dbcode: CMFD\\
dbname: CMFD202501\\
filename: 1024464199.nh},
