  author = {Mourtaday, Nada and Bati, M{\'e}gane and Blanco, St{\'e}phane and Dufresne, Jean-Louis and El Hafi, Mouna and Eymet, Vincent and Forest, Vincent and Fournier, Richard and Gautrais, Jacques and Lapeyre, Paule and {Nyffenegger-P{\'e}r{\'e}}, Yaniss and Villefranque, Najda},
