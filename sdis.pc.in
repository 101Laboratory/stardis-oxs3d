prefix=@PREFIX@
includedir=${prefix}/include
libdir=${prefix}/lib

Requires: \
 rsys >= @RSYS_VERSION@,\
 s2d >= @S2D_VERSION@,\
 s3d >= @S3D_VERSION@,\
 star-sp >= @SSP_VERSION@
Requires.private:\
 senc2d >= @SENC3D_VERSION@,\
 senc3d >= @SENC3D_VERSION@, \
 swf >= @SWF_VERSION@ @MPI@
Name: sdis
Description: Stardis Solver
Version: @VERSION@
Libs: -L${libdir} -lsdis
Libs.private: -fopenmp -lm
CFlags: -I${includedir}
